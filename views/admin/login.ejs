<%- include('../partials/header') %>

<div class="card shadow-sm border-0 p-4 mx-auto" style="max-width: 420px;">
  <h3 class="fw-bold mb-3 text-center">เข้าสู่ระบบผู้ดูแล (Admin)</h3>
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <form method="post" action="/admin/login">
    <div class="mb-3">
      <label class="form-label">อีเมล Admin</label>
      <input type="email" name="email" class="form-control" placeholder="Enter your Email" required>
    </div>
    <div class="mb-3">
      <label class="form-label">รหัสผ่าน</label>
      <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
    </div>
    <button type="submit" class="btn btn-dark w-100 fw-bold">เข้าสู่ระบบ</button>
  </form>
</div>

<%- include('../partials/footer') %>
