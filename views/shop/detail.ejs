<%- include('../partials/header') %>

<a href="/" class="btn btn-outline-secondary btn-sm mb-3">&larr; กลับหน้ารวมเมนู</a>

<div class="card shadow-sm border-0 p-4">
  <div class="row g-4 align-items-center">
    <div class="col-md-5">
      <img src="<%= product.imageUrl %>" class="img-fluid rounded" alt="<%= product.name %>">
    </div>
    <div class="col-md-7">
      <span class="badge bg-warning text-dark mb-2"><%= product.category %></span>
      <h2 class="fw-bold"><%= product.name %></h2>
      <p class="text-muted my-3"><%= product.description || 'เมนูไข่ปรุงสดใหม่ รสชาติกลมกล่อม' %></p>
      <h3 class="text-danger fw-bold mb-3">ราคา ฿<%= product.price.toLocaleString('th-TH') %></h3>
      <p class="mb-4">จำนวนพร้อมเสิร์ฟ: <strong><%= product.stock %> จาน</strong></p>

      <% if (product.stock > 0) { %>
        <form method="post" action="/cart/add/<%= product._id %>" class="row g-2 align-items-center" style="max-width: 320px;">
          <div class="col-5">
            <input type="number" name="qty" value="1" min="1" max="<%= product.stock %>" class="form-control">
          </div>
          <div class="col-7">
            <button type="submit" class="btn btn-warning fw-bold w-100">+ ใส่ตะกร้า</button>
          </div>
        </form>
      <% } else { %>
        <button class="btn btn-secondary" disabled>เมนูนี้หมดชั่วคราว</button>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>