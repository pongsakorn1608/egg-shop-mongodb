<%- include('../partials/header') %>

<div class="p-4 mb-4 bg-warning bg-gradient rounded-3 text-dark shadow-sm">
  <h1 class="h3 fw-bold mb-1">รวมเมนูไข่จานเด็ด ปรุงสดใหม่ทุกจาน</h1>
  <p class="mb-0">เลือกอร่อยได้ทั้งข้าวไข่ข้น ไข่เจียว ไข่ดาว และข้าวหน้าไข่สไตล์ญี่ปุ่น</p>
</div>

<!-- ฟอร์มค้นหาและกรองหมวดหมู่ -->
<form method="get" action="/" class="row g-2 mb-4 bg-white p-3 rounded shadow-sm">
  <div class="col-md-5">
    <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="ค้นหาชื่อเมนูไข่ เช่น ปู, กุ้ง, เบคอน...">
  </div>
  <div class="col-md-4">
    <select name="category" class="form-select">
      <option value="">-- ทุกหมวดหมู่เมนู --</option>
      <% categories.forEach(cat => { %>
        <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>><%= cat %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-3 d-flex gap-2">
    <button type="submit" class="btn btn-warning fw-bold flex-grow-1">ค้นหา / กรอง</button>
    <a href="/" class="btn btn-outline-secondary">ล้างค่า</a>
  </div>
</form>

<p class="text-muted mb-3">พบเมนูทั้งหมด <strong><%= products.length %></strong> รายการ</p>

<!-- แสดงรายการเมนูไข่ -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
  <% products.forEach(p => { %>
    <div class="col">
      <div class="card h-100 shadow-sm border-0">
        <img src="<%= p.imageUrl %>" class="card-img-top" alt="<%= p.name %>">
        <div class="card-body d-flex flex-column">
          <span class="badge bg-warning text-dark align-self-start mb-2"><%= p.category %></span>
          <h5 class="card-title fs-6 fw-bold"><%= p.name %></h5>
          <p class="text-danger fw-bold fs-5 mb-1">฿<%= p.price.toLocaleString('th-TH') %></p>
          <p class="text-muted small mb-3">พร้อมเสิร์ฟ: <%= p.stock %> จาน</p>
          <div class="mt-auto d-grid gap-2">
            <a href="/products/<%= p._id %>" class="btn btn-outline-dark btn-sm">ดูรายละเอียด</a>
            <form method="post" action="/cart/add/<%= p._id %>">
              <button class="btn btn-warning btn-sm w-100 fw-bold" <%= p.stock === 0 ? 'disabled' : '' %>>
                <%= p.stock === 0 ? 'สินค้าหมด' : '+ ใส่ตะกร้า' %>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<% if (!products.length) { %>
  <div class="alert alert-secondary text-center mt-4">ไม่พบเมนูไข่ที่ค้นหา ลองเปลี่ยนคำค้นหาใหม่อีกครั้ง</div>
<% } %>

<%- include('../partials/footer') %>